# Compose defaults: containers use service DNS names. This file is not a complete host-side `go run` profile;
# the canonical issuer below must remain `keycloak`, and a host-side token request must use:
# curl --connect-to keycloak:8080:localhost:8081 http://keycloak:8080/realms/backend-go/protocol/openid-connect/token
HTTP_ADDR=:18080
DATABASE_URL=postgres://postgres:postgres@localhost:5433/backend_go?sslmode=disable
OIDC_ISSUER_URL=http://keycloak:8080/realms/backend-go
OIDC_AUDIENCE=backend-go
OIDC_DISCOVERY_TIMEOUT=5s
SQS_ENDPOINT=http://localhost:4566
SQS_REGION=us-east-1
SQS_OPERATIONS_QUEUE_URL=http://localhost:4566/000000000000/operations.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/events.fifo
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
